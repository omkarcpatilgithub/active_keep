# Clerk (the Next.js SDK reads the NEXT_PUBLIC_ name for the publishable key)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat

# Supabase (server-side only usage; the service role key must never be public)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# External chatbot API. Leave empty to use the built-in mock.
CHAT_API_URL=
# Optional shared secret sent as "Authorization: Bearer <key>" to the chatbot API
CHAT_API_KEY=
